<Application x:Class="OnimushaPS5Adapter.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#090908" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#0D0D0B" />
        <SolidColorBrush x:Key="PanelBackground" Color="#12120F" />
        <SolidColorBrush x:Key="PanelRaisedBackground" Color="#181711" />
        <SolidColorBrush x:Key="GoldBrush" Color="#B99754" />
        <SolidColorBrush x:Key="GoldBrightBrush" Color="#E1C27B" />
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#70592F" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2EFE7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9E9A90" />
        <SolidColorBrush x:Key="CrimsonBrush" Color="#9B2723" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#D4C27F" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D96E5F" />

        <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#15130E" />
            <GradientStop Offset="0.52" Color="#0B0B09" />
            <GradientStop Offset="1" Color="#17110D" />
        </LinearGradientBrush>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SamuraiButton" TargetType="Button">
            <Setter Property="Margin" Value="0,6,10,6" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="#1A1914" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#282419" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0F0E0B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource SamuraiButton}">
            <Setter Property="Background" Value="{StaticResource GoldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
            <Setter Property="Foreground" Value="#0A0907" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SamuraiButton}">
            <Setter Property="BorderBrush" Value="#7B3B34" />
            <Setter Property="Foreground" Value="#E8C9C3" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SamuraiButton}" />

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#080807" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource GoldBrightBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource GoldDarkBrush}" />
            <Setter Property="BorderBrush" Value="#564725" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="54" Height="28">
                            <Border x:Name="Track" Background="#24231E" BorderBrush="#5D5137"
                                    BorderThickness="1" CornerRadius="14" />
                            <Ellipse x:Name="Knob" Width="20" Height="20" Margin="4,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="#C9C5BA" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#7B622F" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFF7E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VoiceLanguageChoice" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#12110E" />
            <Setter Property="Foreground" Value="#B8B2A5" />
            <Setter Property="BorderBrush" Value="#514629" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush"
                                        Value="{StaticResource GoldBrightBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#211E15" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush"
                                        Value="{StaticResource GoldBrightBrush}" />
                                <Setter Property="Foreground" Value="#0A0907" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PercentSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="200" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  IsTabStop="False" Background="{StaticResource GoldBrightBrush}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{TemplateBinding Background}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  IsTabStop="False" Background="#353125">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{TemplateBinding Background}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="VolumeKnob"
                                                         Fill="{StaticResource GoldBrightBrush}"
                                                         Stroke="#FFF2C9" StrokeThickness="1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="VolumeKnob" Property="Fill" Value="#FFF2C9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SamuraiTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#AAA69B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="2" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Marker" Width="3" Height="20" Background="Transparent"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap" Text="{TemplateBinding Header}" />
                                <TextBlock x:Name="Arrow" Grid.Column="3" VerticalAlignment="Center"
                                           Foreground="{StaticResource GoldBrush}" Text="›" Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#171611" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1D1A12" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource GoldDarkBrush}" />
                                <Setter TargetName="Marker" Property="Background" Value="{StaticResource GoldBrightBrush}" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SamuraiTabControl" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="212" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                                    BorderBrush="{StaticResource GoldDarkBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <TextBlock Margin="22,24,0,0" VerticalAlignment="Top"
                                               Style="{StaticResource EyebrowText}" Text="{DynamicResource Navigation}" />
                                    <TabPanel IsItemsHost="True" Margin="18,60,18,112"
                                              VerticalAlignment="Top" KeyboardNavigation.TabIndex="1" />
                                    <StackPanel Margin="24" VerticalAlignment="Bottom">
                                        <Border Width="38" Height="38" BorderBrush="{StaticResource CrimsonBrush}"
                                                BorderThickness="1" CornerRadius="2" HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#BC5148" FontSize="19" Text="武" />
                                        </Border>
                                        <TextBlock Margin="0,10,0,0" Foreground="#625F57" FontSize="10"
                                                   Text="刀に宿る、心。" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource PageBackground}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
