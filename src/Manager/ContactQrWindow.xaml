<Window x:Class="OnimushaPS5Adapter.Manager.ContactQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ContactUpdateNotifications}"
        Width="940" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackground}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource GoldDarkBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource ContactUpdates}" />
                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold"
                               Text="{DynamicResource WechatContactQqUpdateGroup}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22,26,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{DynamicResource WechatContact}" />
                        <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Text="{DynamicResource FeedbackDiscussion}" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#070706" BorderBrush="{StaticResource GoldDarkBrush}"
                            BorderThickness="1" Padding="10">
                        <Grid>
                            <Image x:Name="WechatContactImage" Stretch="Uniform" />
                            <TextBlock x:Name="WechatMissingText" Margin="26" VerticalAlignment="Center"
                                       Foreground="#817C72" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource WechatQrImageIsNotInstalled}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource GoldBrightBrush}"
                               TextAlignment="Center" Text="{DynamicResource ScanToAddOnWechat}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{DynamicResource QqUpdateGroup}" />
                        <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Text="{DynamicResource Group1124324535}" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#070706" BorderBrush="{StaticResource GoldDarkBrush}"
                            BorderThickness="1" Padding="10">
                        <Grid>
                            <Image x:Name="QqGroupImage" Stretch="Uniform" />
                            <TextBlock x:Name="QqMissingText" Margin="26" VerticalAlignment="Center"
                                       Foreground="#817C72" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource QqGroupQrImageIsNotInstalled}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource GoldBrightBrush}"
                               TextAlignment="Center" Text="{DynamicResource ScanToJoinForReleaseNotifications}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#40351F" BorderThickness="0,1,0,0" Background="#0C0C0A">
            <Button Width="118" HorizontalAlignment="Right" Margin="0,7,24,7"
                    Content="{DynamicResource Close}" IsDefault="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
